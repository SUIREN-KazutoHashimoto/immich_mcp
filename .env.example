# Copy to .env and replace example URLs with deployment values.
# No Immich API key belongs here. Each user registers their key in /connect.
IMMICH_BASE_URL=http://immich-server:2283/api
IMMICH_EXPECTED_VERSION=3.3.5
MCP_PUBLIC_BASE_URL=https://immich-mcp.example.com
MCP_LISTEN_HOST=127.0.0.1
MCP_LISTEN_PORT=3000
ACCESS_ISSUER=https://your-team.cloudflareaccess.com
ACCESS_AUDIENCE=replace-with-access-application-audience
ACCESS_JWKS_URL=https://your-team.cloudflareaccess.com/cdn-cgi/access/certs
# Supply 32 raw random bytes outside STORAGE_PATH via a separate secret mount.
# Readiness detects missing/changed keys. Preserve the original key for existing data.
VAULT_MASTER_KEY_FILE=/run/secrets/immich-mcp-master-key
STORAGE_PATH=./data
# Optional separate persistent DB file; default is STORAGE_PATH/vault.sqlite.
# DATABASE_PATH=/data/vault.sqlite
# Exact trusted DNS hosts only. Empty disables external attachment downloads;
# authenticated resumable uploads remain available in /connect.
FILE_SOURCE_ALLOWED_HOSTS=
MAX_UPLOAD_BYTES=1073741824
# Logical encrypted bytes plus reservations; leave headroom for SQLite/WAL/filesystem overhead.
STORAGE_QUOTA_BYTES=3221225472
GLOBAL_STORAGE_QUOTA_BYTES=12884901888
MAX_RESULT_BYTES=1073741824
# Bound decoded inspection separately from stored wire bytes.
MAX_DECODED_RESULT_BYTES=1073741824
MAX_UPSTREAM_CONCURRENCY=8
UPSTREAM_CONNECT_TIMEOUT_MS=10000
UPSTREAM_IDLE_TIMEOUT_MS=30000
INLINE_RESULT_MAX_BYTES=131072
# Bound each inspected scalar and union; larger originals remain retained.
JSON_VALUE_MAX_BYTES=1048576
RESULT_TTL_SECONDS=3600
STAGING_TTL_SECONDS=3600
MAX_JOBS_PER_PRINCIPAL=50
CLEANUP_INTERVAL_SECONDS=60
