# Copy outside the repository/build context; use real deployment values.
MCP_IMAGE=immich-mcp:1.0.0-beta.6
NODE_IMAGE=node:24.22.2-bookworm-slim
CLOUDFLARED_IMAGE=cloudflare/cloudflared:2026.10.7
# Replace image tags with reviewed @sha256 digests after pulling on the deployment host.
MCP_ENV_FILE=/absolute/private/immich-mcp.env
MCP_DATA_DIR=/absolute/data/immich-mcp
MCP_MASTER_KEY_FILE=/absolute/private/immich-mcp-master.key
CLOUDFLARE_TUNNEL_TOKEN_FILE=/absolute/private/immich-mcp-tunnel-token
# Existing network containing the Immich API service. No DB/photo volume is mounted.
IMMICH_NETWORK=immich_default
